var campos = document.querySelectorAll('div[data-params]');
campos.forEach(c => {
  var p = c.getAttribute('data-params');
  if(p) {
    var id = p.match(/\[(\d+),/);
    var nombre = p.match(/".*?"/);
    if(id && nombre) console.log("Campo: " + nombre[0] + " -> entry." + id[1]);
  }
});


